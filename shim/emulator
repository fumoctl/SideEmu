#!/bin/sh
set -eu

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

new_path=""
old_ifs=$IFS
IFS=:
for entry in ${PATH:-}; do
  if [ "$entry" != "$self_dir" ] && [ -n "$entry" ]; then
    if [ -z "$new_path" ]; then
      new_path=$entry
    else
      new_path="$new_path:$entry"
    fi
  fi
done
IFS=$old_ifs
PATH=$new_path
export PATH

real=$(command -v emulator 2>/dev/null || true)
if [ -z "$real" ]; then
  sdk_dir=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}
  if [ -n "$sdk_dir" ] && [ -x "$sdk_dir/emulator/emulator" ]; then
    real="$sdk_dir/emulator/emulator"
  fi
fi

if [ -z "$real" ]; then
  echo "sidemu emulator shim: real 'emulator' binary not found in PATH or ANDROID_HOME/ANDROID_SDK_ROOT" >&2
  exit 127
fi

if [ "${SIDEMU_ACTIVE:-}" = "1" ]; then
  inject=1
  for arg in "$@"; do
    case "$arg" in
      -no-window|-list-avds|-help|-help*|-version|-accel-check|-check-snapshot-loadable)
        inject=0
        break
        ;;
    esac
  done
  if [ "$inject" -eq 1 ]; then
    exec "$real" -no-window "$@"
  fi
fi

exec "$real" "$@"
